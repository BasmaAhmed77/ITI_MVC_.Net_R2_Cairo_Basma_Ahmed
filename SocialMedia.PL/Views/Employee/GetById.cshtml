@using SocialMedia.BLL.ModelVM.EmployeeVM;
@model GetEmployeeVM

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow border-0 mt-3">
            <div class="card-header bg-dark text-white text-uppercase py-3 d-flex justify-content-between align-items-center">
                <h4 class="card-title mb-0 fw-bold">
                    <i class="fas fa-id-card me-2"></i>Employee Details
                </h4>
                <span class="badge bg-info text-dark">ID: #@Model.EmployeeId</span>
            </div>

            <div class="card-body p-4 text-center">

                <div class="mb-4">
                    @if (!string.IsNullOrEmpty(Model.PathImage))
                    {
                        <img src="~/Files/@Model.PathImage"
                             class="rounded-circle img-thumbnail shadow-sm"
                             width="140"
                             height="140"
                             style="object-fit: cover;"
                             alt="@Model.Name's Profile Image" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-secondary text-white d-inline-flex align-items-center justify-content-center shadow-sm"
                             style="width: 140px; height: 140px;">
                            <i class="fas fa-user fa-4x"></i>
                        </div>
                    }
                </div>

                <h3 class="fw-bold mb-1">@Model.Name</h3>
                <p class="text-muted mb-4">
                    <span class="badge bg-secondary fs-6">@Model.DepartmentName</span>
                </p>

                <ul class="list-group list-group-flush text-start mb-4">
                    <li class="list-group-item d-flex justify-content-between align-items-center px-3 py-3">
                        <span class="fw-bold text-muted">
                            <i class="fas fa-user me-2 text-primary"></i>Full Name
                        </span>
                        <span class="fw-bold">@Model.Name</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-3 py-3">
                        <span class="fw-bold text-muted">
                            <i class="fas fa-calendar-alt me-2 text-primary"></i>Age
                        </span>
                        <span>@Model.Age years old</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-3 py-3">
                        <span class="fw-bold text-muted">
                            <i class="fas fa-building me-2 text-primary"></i>Department
                        </span>
                        <span class="fw-bold text-dark">@Model.DepartmentName</span>
                    </li>
                </ul>

                <div class="d-flex justify-content-between align-items-center pt-2">
                    <a asp-action="GetAll" class="btn btn-outline-secondary text-uppercase">
                        <i class="fas fa-arrow-left me-1"></i> Back to List
                    </a>

                    <div>
                        <a asp-action="Edit" asp-route-id="@Model.EmployeeId" class="btn btn-warning text-uppercase me-2">
                            <i class="fas fa-edit me-1"></i> Edit
                        </a>

                        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this employee?');">
                            <input type="hidden" name="employeeId" value="@Model.EmployeeId" />
                            <button type="submit" class="btn btn-outline-danger text-uppercase">
                                <i class="fas fa-trash me-1"></i> Delete
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>