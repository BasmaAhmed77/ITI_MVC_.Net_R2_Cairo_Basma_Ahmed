@using SocialMedia.BLL.ModelVM.EmployeeVM
@model List<GetEmployeeVM>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-uppercase fw-bold">Employee Directory</h2>
    <a asp-controller="Employee" asp-action="Create" class="btn btn-primary text-uppercase">
        <i class="fas fa-plus me-1"></i> Add New Employee
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark text-uppercase">
                    <tr>
                        <th class="ps-4">Profile</th>
                        <th>Name</th>
                        <th>Age</th>
                        <th>Department</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var emp in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    @if (!string.IsNullOrEmpty(emp.PathImage))
                                    {
                                        <img src="~/Files/@emp.PathImage" class="rounded-circle" width="48" height="48" style="object-fit: cover;" alt="@emp.Name's profile image" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                            <i class="fas fa-user"></i>
                                        </div>
                                    }
                                </td>
                                <td class="fw-bold">@emp.Name</td>
                                <td>@emp.Age</td>
                                <td>
                                    <span class="badge bg-info text-dark">
                                        @(string.IsNullOrEmpty(emp.DepartmentName) ? "N/A" : emp.DepartmentName)
                                    </span>
                                </td>
                                <td class="text-end pe-4">

                                    <a asp-controller="Employee" asp-action="GetById" asp-route-id="@emp.EmployeeId" class="btn btn-sm btn-outline-info me-1">
                                        <i class="fas fa-eye me-1"></i> View
                                    </a>

                                    <a asp-controller="Employee" asp-action="Edit" asp-route-id="@emp.EmployeeId" class="btn btn-sm btn-outline-warning me-1">
                                        <i class="fas fa-edit me-1"></i> Edit
                                    </a>
                                  
                                    <form asp-controller="Employee" asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete @emp.Name?');">
                                        <input type="hidden" name="employeeId" value="@emp.EmployeeId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash me-1"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                No employees found. Click <strong>Add New Employee</strong> to create one.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>