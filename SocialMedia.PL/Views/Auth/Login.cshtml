@using SocialMedia.BLL.ModelVM.ApplicationUserVM
@model LoginVM

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow border-0 mt-4">
            <div class="card-header bg-dark text-white text-center py-3">
                <h4 class="mb-0 text-uppercase fw-bold">
                    <i class="fas fa-lock me-2"></i>Login
                </h4>
            </div>
            <div class="card-body p-4">
                <form asp-controller="Auth" asp-action="Login" method="post">
                    <!-- Displays top-level authentication failure messages -->
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold"></label>
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-bold"></label>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 text-uppercase fw-bold py-2">
                        Sign In
                    </button>
                </form>
            </div>
            <div class="card-footer text-center py-3">
                <span class="text-muted">Don't have an account?</span>
                <a asp-action="Register" asp-controller="Auth" class="text-decoration-none fw-bold ms-1">Register</a>
            </div>
        </div>
    </div>
</div>